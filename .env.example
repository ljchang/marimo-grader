# Copy to .env. Every GRADER_* value is read by backend/src/grader/config.py.

GRADER_ENV=dev                      # dev | test | prod  (prod refuses to start without the secrets below)
GRADER_BASE_URL=http://localhost:8000
GRADER_FRONTEND_URL=http://localhost:5173
GRADER_DATABASE_URL=postgresql+psycopg://grader:grader@localhost:5432/grader
# Production (DigitalOcean Managed PostgreSQL; sslmode=require is mandatory):
# GRADER_DATABASE_URL=postgresql+psycopg://grader:<password>@private-db-postgresql-nyc3-12345-do-user-1-0.b.db.ondigitalocean.com:25060/grader?sslmode=require
POSTGRES_PASSWORD=grader                # only used by the local postgres in docker-compose.yml

# Web sessions
GRADER_SESSION_SECRET=change-me-to-a-long-random-string
GRADER_COOKIE_SECURE=false          # true in prod

# Notebook tokens (Ed25519 PEM). Generate:
#   cd backend && uv run python -c "from grader.auth.tokens import generate_private_key_pem as g; print(g())"
GRADER_JWT_PRIVATE_KEY_PEM=

# Auth: dev enables /api/v1/auth/dev-login?netid=...; saml uses Dartmouth.
GRADER_AUTH_MODE=dev
GRADER_SAML_SP_ENTITY_ID=https://grader.dartbrains.org
GRADER_SAML_IDP_ENTITY_ID=urn:mace:incommon:dartmouth.edu
GRADER_SAML_IDP_SSO_URL=https://login.dartmouth.edu/cas/idp/profile/SAML2/POST/SSO
GRADER_SAML_IDP_LOGOUT_URL=https://logout.dartmouth.edu
GRADER_SAML_IDP_CERT=               # PEM body from the IdP metadata (pbs_knowledge/backend/dartmouth-idp-metadata.xml)
GRADER_SAML_SP_CERT=                # self-signed SP cert (PEM)
GRADER_SAML_SP_KEY=                 # SP private key (PEM) — Docker secret in prod

# Origins allowed to run the notebook widget (JSON list)
GRADER_CORS_ORIGINS=["https://dartbrains.org","https://molab.marimo.io","http://localhost:2718"]

GRADER_ARTIFACT_DIR=./data/artifacts

# Deployment (docker-compose.yml / docker-compose.prod.yml; see deploy/README.md)
GRADER_HOST=localhost               # hostname Caddy serves; prod: grader.dartbrains.org
GRADER_STAGING=0                    # 1 on staging: adds X-Robots-Tag: noindex
GRADER_IMAGE_TAG=main               # GHCR image tag to run in prod: main | sha-<short> | 1.2.3
